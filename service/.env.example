# Application only. Copy to service/.env; never commit that private file.
# Use: docker compose --env-file service/.env up --build -d
# Generate the token locally; the backend and service must share it.
DEMOLOGIC_SERVICE_TOKEN=
DEMOLOGIC_MODE=demo
DEMOLOGIC_CONFIG_ID=qwen-v4-v1
DEMOLOGIC_IMAGE=demologic:local
DEMOLOGIC_FREE_TIER_CONFIRMED=false
DEMOLOGIC_TIMEOUT_SECONDS=60
DEMOLOGIC_MIN_INTERVAL_SECONDS=1
# Operator setting, 1–10. Default stays 3; batch ceiling stays 120 attempts.
DEMOLOGIC_MAX_ATTEMPTS_PER_EVENT=3
# Needed only for live mode. No notebook/Gemini keys belong in this file yet.
HETZNER_API_KEY=

# DR-33 private draft experiment only. No automatic/public publication.
DEMOLOGIC_SUMMARY_ENABLED=false
DEMOLOGIC_SUMMARY_TIMEOUT_SECONDS=60
DEMOLOGIC_SUMMARY_CONFIG_ID=daily-summary-v1

# Total summary attempts per input, independent of the tag attempt limit.
DEMOLOGIC_SUMMARY_MAX_ATTEMPTS=3
