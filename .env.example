# Notebook experiments only. Service settings are in service/.env.example.
# Copy to .env and fill in your own keys. Never commit .env.
# These keys are read only for live calls and are never saved in experiment reports.
GROQ_API_KEY=
HETZNER_API_KEY=

# false = replay cached answers; true = also send missing requests.
NOTEBOOK07_RUN_LIVE=false
# screen = compare prompts; check = evaluate the selected prompt.
NOTEBOOK07_STAGE=check
NOTEBOOK07_PROVIDERS=groq,hetzner
# Wait for provider resets up to this many seconds per retry, then pause.
# Requests still have at most 3 attempts and a 5-minute total deadline.
NOTEBOOK07_MAX_RETRY_WAIT_SECONDS=120

# Notebook 08: GPT-OSS-120B on Groq, search off versus search on.
# Uses GROQ_API_KEY only. Replay is the default.
NOTEBOOK08_RUN_LIVE=false
# These accounts use free tiers. This setting does not enable billing.
# Paid runs need a priced budget guard before use.

# Notebook 07b: paired Hetzner Qwen model comparison; uses HETZNER_API_KEY.
NOTEBOOK07B_RUN_LIVE=false

# Notebook 10: approved final benchmark; uses HETZNER_API_KEY.
# Keep false to replay the completed run without new API calls.
NOTEBOOK10_RUN_LIVE=false

# OpenAI / Gemini follow-up experiments. Credentials only; no live run enabled.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Gemini search comparison: false replays saved answers without API calls.
NOTEBOOK12_RUN_LIVE=false

# Required evidence comparison: replay by default.
NOTEBOOK13_RUN_LIVE=false

# Notebook 14: broader title-only Gemini comparison (paid, budget guarded).
NOTEBOOK14_RUN_LIVE=false
NOTEBOOK14_STAGE=development

# Notebook 15: adapted Demo Radar Gem, native search on/off.
NOTEBOOK15_RUN_LIVE=false

# Notebook 15: independent Qwen Gem comparison, confirmed free Hetzner account.
NOTEBOOK15_QWEN_RUN_LIVE=false

# Notebook 17: replay the private tag-policy experiment by default.
# Set true to fill missing responses; Gemini calls use the shared budget guard.
NOTEBOOK17_RUN_LIVE=false

# Notebook 18: replay prepared practical-trial suggestions by default.
NOTEBOOK18_RUN_LIVE=false

# Notebook 19: replay uncertainty checks; search runs only after its gate passes.
NOTEBOOK19_RUN_LIVE=false
NOTEBOOK19_STAGE=audit

# Notebook 19: eight-case explanation follow-up; replay saved answers by default.
NOTEBOOK19_EXPLAIN_LIVE=false

# Notebook 20: replay the background-knowledge comparison by default.
NOTEBOOK20_RUN_LIVE=false

# Notebook 21: reviewed-only controlled rubric comparison; false replays saved answers.
NOTEBOOK21_RUN_LIVE=false

# Notebook 22: approved v3/v4 rubric comparison on 54 reviewed cases; false replays.
NOTEBOOK22_RUN_LIVE=false

# Notebook 23: fixed v4 fresh-case confirmation; false replays, true fills missing calls.
NOTEBOOK23_RUN_LIVE=false
