# Application only. Copy to service/.env; never commit that private file.
# Use: docker compose --env-file service/.env up --build -d
# Generate the token locally; the backend and service must share it.
DEMOLOGIC_SERVICE_TOKEN=
DEMOLOGIC_MODE=demo
DEMOLOGIC_CONFIG_ID=qwen-v4-v1
DEMOLOGIC_IMAGE=demologic:local
DEMOLOGIC_FREE_TIER_CONFIRMED=false
DEMOLOGIC_TIMEOUT_SECONDS=60
DEMOLOGIC_MIN_INTERVAL_SECONDS=1
# Operator setting, 1–10. Default stays 3; batch ceiling stays 30 attempts.
DEMOLOGIC_MAX_ATTEMPTS_PER_EVENT=3
# Needed only for live mode. Do not copy notebook settings into this file.
HETZNER_API_KEY=

# DR-33 private draft experiment only. No automatic/public publication.
DEMOLOGIC_SUMMARY_ENABLED=false
DEMOLOGIC_SUMMARY_TIMEOUT_SECONDS=60
DEMOLOGIC_SUMMARY_CONFIG_ID=hetzner-daily-v1

# Total summary attempts per input, independent of the tag attempt limit.
DEMOLOGIC_SUMMARY_MAX_ATTEMPTS=3

# Optional compatibility profiles from the approved catalogs (comma-separated).
# Retain profiles required by saved jobs; this does not change Radar's defaults.
DEMOLOGIC_RETAINED_TAG_CONFIGS=
DEMOLOGIC_RETAINED_SUMMARY_CONFIGS=
DEMOLOGIC_ENVIRONMENT=local

# Optional Gemini profiles. Keep disabled until the combined feature release is approved.
GEMINI_API_KEY=
DEMOLOGIC_GEMINI_ENABLED=false
# Non-secret billing account label. One journal must own all spending for this account.
DEMOLOGIC_GEMINI_ACCOUNT=
# Operator-approved USD limits: per logical run, shared UTC day, account UTC day.
# Empty values refuse paid calls. Never copy research budgets here.
DEMOLOGIC_PAID_RUN_USD=
DEMOLOGIC_PAID_PERIOD_USD=
DEMOLOGIC_PAID_ACCOUNT_USD=
